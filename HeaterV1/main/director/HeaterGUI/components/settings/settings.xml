<component>
     <previews>
        <preview name="settings" style_bg_color="#backgraund" width="141" height="126" />
    </previews>

    <styles>
        <style bg_opa="0" name="main" width="141" height="126" pad_all="0" border_width="0" text_font="font_ch_label_temp_small"/>
        <style name="selected" text_color="#subtext" text_opa="255"/>
        <style name="inactive" opa="100" /> 
    </styles>
     <view extends="lv_image" scrollable="false" src="info_bg" inner_align="stretch">
        <style name="main" />
        <column width="100%" height="126" style_bg_opa="0" name="scrollColumn" style_pad_top="0">
            <row width="100%" height="23">
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="0"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="TEMP:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text-fmt="%i°" bind_text="default_temp" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <style name="inactive" selector="checked"/>
                <bind_state_if_eq state="checked" subject="heaterRunning" ref_value="1"/>
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="1"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="PREHEAT:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text-fmt="%dm" bind_text="preHeat" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <style name="inactive" selector="checked"/>
                <bind_state_if_eq state="checked" subject="heaterRunning" ref_value="1"/>
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="2"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="TIMER:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text="timerType" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="3"/>
                    </lv_label> 
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="SOUND:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0" style_bg_opa="0">
                     <lv_label bind_text="soundEnable" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="4"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="LIGHT:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text-fmt="%d%%" bind_text="brightness" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="5"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="SLEEP:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text-fmt="%ds" bind_text="sleepTimer" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
            <row width="100%" height="23">
                <column width="24" height="100%" style_pad_right="0"  style_bg_opa="0" style_margin_top="-14">
                    <lv_label text="•" style_text_opa="0" style_text_font="font_channel_dot" style_text_color="#subtext" style_text_align="center" width="24">
                        <style name="selected" selector="checked"/>
                        <bind_state_if_eq state="checked" subject="settingsSelect" ref_value="6"/>
                    </lv_label>
                </column>
                <column width="67" height="100%" style_pad_right="0"  style_bg_opa="0">
                    <lv_label text="FLIP:" style_text_color="#subtext" style_text_align="center"/>
                </column>   
                <column width="50" height="100%" style_pad_right="0"  style_bg_opa="0">
                     <lv_label bind_text="orientation" style_text_color="#maintext" style_text_align="center"/>
                </column>          
            </row>
        </column>
    </view>
</component>